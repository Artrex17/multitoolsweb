---
import type { Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  es: {
    heading: 'Contador de palabras y caracteres',
    input: 'Escribe o pega tu texto aquí',
    words: 'Palabras',
    chars: 'Caracteres',
    charsNoSpaces: 'Sin espacios',
  },
  en: {
    heading: 'Word & character counter',
    input: 'Type or paste your text here',
    words: 'Words',
    chars: 'Characters',
    charsNoSpaces: 'No spaces',
  },
}[lang];
---

<section class="panel tool">
  <h1>{t.heading}</h1>
  <label>{t.input}<textarea id="text" rows="12"></textarea></label>
  <div class="counters">
    <span class="screen-mini">{t.words} <strong id="words">0</strong></span>
    <span class="screen-mini">{t.chars} <strong id="chars">0</strong></span>
    <span class="screen-mini">{t.charsNoSpaces} <strong id="chars-no-spaces">0</strong></span>
  </div>
</section>

<style>
  .counters {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
    font-weight: 600;
    color: var(--ink-soft);
  }
</style>

<script>
  import { countWords, countChars } from '../../lib/wordcount';

  const textEl = document.querySelector<HTMLTextAreaElement>('#text')!;
  const wordsEl = document.querySelector('#words')!;
  const charsEl = document.querySelector('#chars')!;
  const charsNoSpacesEl = document.querySelector('#chars-no-spaces')!;

  textEl.addEventListener('input', () => {
    wordsEl.textContent = String(countWords(textEl.value));
    charsEl.textContent = String(countChars(textEl.value));
    charsNoSpacesEl.textContent = String(countChars(textEl.value, false));
  });
</script>
