---
import type { Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  es: {
    heading: 'Generador de contraseñas',
    length: 'Longitud',
    lowercase: 'Minúsculas (a-z)',
    uppercase: 'Mayúsculas (A-Z)',
    numbers: 'Números (0-9)',
    symbols: 'Símbolos (!@#...)',
    generate: 'Generar contraseña',
  },
  en: {
    heading: 'Password generator',
    length: 'Length',
    lowercase: 'Lowercase (a-z)',
    uppercase: 'Uppercase (A-Z)',
    numbers: 'Numbers (0-9)',
    symbols: 'Symbols (!@#...)',
    generate: 'Generate password',
  },
}[lang];
---

<section class="panel tool">
  <h1>{t.heading}</h1>
  <form id="password-form">
    <label>{t.length}<input type="number" id="length" min="4" max="128" value="16" /></label>
    <label class="toggle"><input type="checkbox" id="lowercase" checked /><span class="toggle-track"><span class="toggle-thumb"></span></span>{t.lowercase}</label>
    <label class="toggle"><input type="checkbox" id="uppercase" checked /><span class="toggle-track"><span class="toggle-thumb"></span></span>{t.uppercase}</label>
    <label class="toggle"><input type="checkbox" id="numbers" checked /><span class="toggle-track"><span class="toggle-thumb"></span></span>{t.numbers}</label>
    <label class="toggle"><input type="checkbox" id="symbols" /><span class="toggle-track"><span class="toggle-thumb"></span></span>{t.symbols}</label>
    <div class="actions">
      <button class="btn btn-primary" type="submit">{t.generate}</button>
    </div>
  </form>
  <p class="screen" id="result"></p>
</section>

<script>
  import { generatePassword } from '../../lib/password';

  const form = document.querySelector<HTMLFormElement>('#password-form')!;
  const resultEl = document.querySelector<HTMLParagraphElement>('#result')!;

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    try {
      resultEl.textContent = generatePassword({
        length: Number(document.querySelector<HTMLInputElement>('#length')!.value),
        lowercase: document.querySelector<HTMLInputElement>('#lowercase')!.checked,
        uppercase: document.querySelector<HTMLInputElement>('#uppercase')!.checked,
        numbers: document.querySelector<HTMLInputElement>('#numbers')!.checked,
        symbols: document.querySelector<HTMLInputElement>('#symbols')!.checked,
      });
    } catch (err) {
      resultEl.textContent = (err as Error).message;
    }
  });
</script>
