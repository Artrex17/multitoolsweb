---
import type { Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  es: {
    heading: 'Hash SHA-256 / SHA-512',
    input: 'Texto a procesar',
    algorithm: 'Algoritmo',
    generate: 'Calcular hash',
  },
  en: {
    heading: 'SHA-256 / SHA-512 hash',
    input: 'Text to hash',
    algorithm: 'Algorithm',
    generate: 'Compute hash',
  },
}[lang];
---

<section class="panel tool">
  <h1>{t.heading}</h1>
  <form id="hash-form">
    <label>{t.input}<textarea id="text" rows="6"></textarea></label>
    <label>
      {t.algorithm}
      <div class="rocker">
        <label class="rocker-option"><input type="radio" name="algorithm" value="SHA-256" checked /><span>SHA-256</span></label>
        <label class="rocker-option"><input type="radio" name="algorithm" value="SHA-512" /><span>SHA-512</span></label>
      </div>
    </label>
    <div class="actions">
      <button class="btn btn-primary" type="submit">{t.generate}</button>
    </div>
  </form>
  <p class="screen" id="result"></p>
</section>

<script>
  import { hashText, type HashAlgorithm } from '../../lib/hash';

  const form = document.querySelector<HTMLFormElement>('#hash-form')!;
  const resultEl = document.querySelector<HTMLParagraphElement>('#result')!;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    const text = document.querySelector<HTMLTextAreaElement>('#text')!.value;
    const algorithm = document.querySelector<HTMLInputElement>('input[name="algorithm"]:checked')!.value as HashAlgorithm;
    resultEl.textContent = await hashText(text, algorithm);
  });
</script>
