---
import type { Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  es: {
    heading: 'Convertir, redimensionar y comprimir imagen',
    file: 'Elige una imagen (PNG, JPEG o WebP)',
    format: 'Formato de salida',
    quality: 'Calidad',
    maxWidth: 'Ancho máximo (px, opcional)',
    maxHeight: 'Alto máximo (px, opcional)',
    convert: 'Convertir',
    download: 'Descargar resultado',
    error: 'No se pudo procesar la imagen. Comprueba que el archivo sea válido.',
  },
  en: {
    heading: 'Convert, resize and compress image',
    file: 'Choose an image (PNG, JPEG or WebP)',
    format: 'Output format',
    quality: 'Quality',
    maxWidth: 'Max width (px, optional)',
    maxHeight: 'Max height (px, optional)',
    convert: 'Convert',
    download: 'Download result',
    error: 'Could not process the image. Check that the file is valid.',
  },
}[lang];
---

<section class="tool">
  <h1>{t.heading}</h1>
  <form id="image-form">
    <label>{t.file}<input type="file" id="file" accept="image/png,image/jpeg,image/webp" required /></label>
    <label>{t.format}
      <select id="format">
        <option value="webp">WebP</option>
        <option value="png">PNG</option>
        <option value="jpeg">JPEG</option>
      </select>
    </label>
    <label>{t.quality}<input type="range" id="quality" min="0.1" max="1" step="0.05" value="0.85" /></label>
    <label>{t.maxWidth}<input type="number" id="maxWidth" min="1" /></label>
    <label>{t.maxHeight}<input type="number" id="maxHeight" min="1" /></label>
    <button type="submit">{t.convert}</button>
  </form>
  <p id="error" role="alert" hidden>{t.error}</p>
  <a id="download" hidden download>{t.download}</a>
</section>

<script>
  import { convertImage, type ImageFormat } from '../../lib/image';

  const form = document.querySelector<HTMLFormElement>('#image-form')!;
  const errorEl = document.querySelector<HTMLParagraphElement>('#error')!;
  const downloadEl = document.querySelector<HTMLAnchorElement>('#download')!;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    errorEl.hidden = true;
    downloadEl.hidden = true;

    const fileInput = document.querySelector<HTMLInputElement>('#file')!;
    const file = fileInput.files?.[0];
    if (!file) return;

    const format = document.querySelector<HTMLSelectElement>('#format')!.value as ImageFormat;
    const quality = Number(document.querySelector<HTMLInputElement>('#quality')!.value);
    const maxWidth = Number(document.querySelector<HTMLInputElement>('#maxWidth')!.value) || undefined;
    const maxHeight = Number(document.querySelector<HTMLInputElement>('#maxHeight')!.value) || undefined;

    try {
      const bitmap = await createImageBitmap(file);
      const blob = await convertImage(bitmap, format, quality, maxWidth, maxHeight);
      downloadEl.href = URL.createObjectURL(blob);
      downloadEl.download = `converted.${format}`;
      downloadEl.hidden = false;
    } catch {
      errorEl.hidden = false;
    }
  });
</script>
