---
import type { Lang } from '../../i18n/strings';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const t = {
  es: {
    heading: 'Formatear JSON',
    input: 'Pega tu JSON aquí',
    format: 'Formatear',
    minify: 'Minificar',
    error: 'JSON inválido.',
  },
  en: {
    heading: 'Format JSON',
    input: 'Paste your JSON here',
    format: 'Format',
    minify: 'Minify',
    error: 'Invalid JSON.',
  },
}[lang];
---

<section class="panel tool">
  <h1>{t.heading}</h1>
  <label>{t.input}<textarea id="json" rows="16"></textarea></label>
  <div class="actions">
    <button class="btn btn-primary" id="format" type="button">{t.format}</button>
    <button class="btn" id="minify" type="button">{t.minify}</button>
  </div>
  <p class="error-strip" id="error" role="alert" hidden>{t.error}</p>
</section>

<script>
  import { formatJson, minifyJson } from '../../lib/json-format';

  const jsonEl = document.querySelector<HTMLTextAreaElement>('#json')!;
  const errorEl = document.querySelector<HTMLParagraphElement>('#error')!;

  document.querySelector('#format')!.addEventListener('click', () => {
    errorEl.hidden = true;
    try {
      jsonEl.value = formatJson(jsonEl.value);
    } catch {
      errorEl.hidden = false;
    }
  });

  document.querySelector('#minify')!.addEventListener('click', () => {
    errorEl.hidden = true;
    try {
      jsonEl.value = minifyJson(jsonEl.value);
    } catch {
      errorEl.hidden = false;
    }
  });
</script>
