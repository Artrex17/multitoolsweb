---
import { common, tools, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  currentPath: string;
}
const { lang, currentPath } = Astro.props;
const t = common[lang];
const items = tools[lang];
const otherLang: Lang = lang === 'es' ? 'en' : 'es';
const toolIndex = items.findIndex((item) => item.href === currentPath);
const otherLangHref = toolIndex === -1 ? `/${otherLang}/` : tools[otherLang][toolIndex].href;
---

<header class="site-header">
  <a class="brand" href={`/${lang}/`}>{t.siteName}</a>
  <nav>
    <ul>
      {items.map((item) => (
        <li>
          <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <a class="lang-switch" href={otherLangHref}>
    {t.languageSwitch}
  </a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1rem;
    border-bottom: 1px solid #ddd;
  }
  .brand {
    font-weight: bold;
    font-size: 1.2rem;
    text-decoration: none;
    color: inherit;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 0.9rem;
  }
  nav a {
    color: inherit;
    text-decoration: none;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    text-decoration: underline;
  }
  .lang-switch {
    margin-left: auto;
    font-size: 0.9rem;
  }
</style>
